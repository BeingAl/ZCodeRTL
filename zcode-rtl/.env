# Real environment variables win over the file; anything left unset
# falls back to the built-in defaults noted below.
# Unknown keys are ignored.

# Chromium DevTools Protocol port used to talk to the ZCode renderer.
# Must match the --remote-debugging-port flag ZCode is restarted with.
# Default: 9222.
ZCODE_RTL_PORT=9222

# Full path of the ZCode executable. Only needed when the
# auto-detection in restart-zcode.mjs fails on this machine.
# Default: unset (auto-detect).
#ZCODE_EXE=/opt/ZCode/zcode
